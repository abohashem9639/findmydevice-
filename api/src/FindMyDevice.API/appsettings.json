{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=FindMyDevice;Username=appuser;Password=appsecret"
  },
  "Jwt": {
    "Issuer": "FindMyDevice",
    "Audience": "FindMyDevice.Client",
    "SigningKey": "PLEASE_REPLACE_WITH_DEVELOPMENT_KEY",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.dev.FindMyDevice.app"
    ]
  },
  "Google": {
    "ClientId": ""
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "FromEmail": "noreply@FindMyDevice.app",
    "FromName": "FindMyDevice Support",
    "SmtpUser": "",
    "SmtpPassword": "",
    "EnableSsl": true,
    "ResetPasswordUrl": "https://app.FindMyDevice.app/reset-password",
    "AppUrl": "https://app.FindMyDevice.app",
    "ResetTokenExpirationMinutes": 60,
    "DefaultLanguage": "en"
  },
  "S3Storage": {
    "AccessKey": "",
    "SecretKey": "",
    "ServiceUrl": "",
    "BucketName": "FindMyDevice"
  }
